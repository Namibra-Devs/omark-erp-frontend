# ============================================================
# Omark ERP Frontend — Environment Variables (template)
# Copy this file to .env and adjust values as needed.
# .env is gitignored — never commit real secrets to this file.
# ============================================================

VITE_API_BASE_URL=https://api.erp.omarkrealestate.com
VITE_API_DOCS_URL=https://api.erp.omarkrealestate.com/docs
VITE_ACCESS_TOKEN_KEY=omark_access_token
VITE_REFRESH_TOKEN_KEY=omark_refresh_token
VITE_TOKEN_REFRESH_BUFFER_MS=60000
